# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string.
# Reuse the same Atlas account as the matchmaking project: create a new
# free-tier cluster/database there (e.g. "eje-website") and paste its
# connection string below. Never commit the real .env file.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eje-website?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - the deployed frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:5173,https://ensijuniorentreprise.com

# Initial admin account, used by `npm run seed:admin`
ADMIN_EMAIL=admin@ensi-je.com
ADMIN_PASSWORD=change-me-now

# Optional: SMTP for contact-form email notifications.
# Leave blank to skip emailing and only store submissions in the database.
# Works for free with a Gmail account + an "App Password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFY_EMAIL=contact@ensi-je.com
